# smartTour Multi-Agent Assistant Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated Gemini API keys (multiple keys for parallel racing and failover)
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3
# Single key fallback (optional, used if GEMINI_API_KEYS is not set)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENSTREETMAP_API_URL=https://nominatim.openstreetmap.org
NODE_ENV=development
